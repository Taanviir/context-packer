{
  "name": "@taanviir/context-packer",
  "version": "0.1.0",
  "description": "Ranks the source files a coding task needs, from the command line, an MCP server, or a Claude Code hook",
  "keywords": [
    "mcp",
    "claude-code",
    "context",
    "retrieval",
    "bm25",
    "code-search",
    "agents"
  ],
  "homepage": "https://taanviir.github.io/context-packer/",
  "bugs": {
    "url": "https://github.com/Taanviir/context-packer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taanviir/context-packer.git"
  },
  "license": "MIT",
  "author": "Taanviir (https://github.com/Taanviir)",
  "type": "module",
  "bin": {
    "context-packer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench": "tsx bench/run.ts",
    "bench:report": "tsx bench/report.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
